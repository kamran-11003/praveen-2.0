        "ur": "بین الاقوامی دستاویزات کے لیے ہیگ کنونشن کی تصدیق"
      },
      "longDescription": {
        "en": "A formal authentication issued by MOFA certifying the validity of public documents under the Hague Apostille Convention (1961) for use abroad.",
        "ur": "وزارت خارجہ کی طرف سے جاری شدہ رسمی تصدیق جو ہیگ اپوسٹیل کنونشن (1961) کے تحت بیرون ملک استعمال کے لیے سرکاری دستاویزات کی تصحیح کی تصدیق کرتی ہے۔"
      },
      "requiredDocuments": [
        {
          "id": "DOC_M001",
          "name": "Original Document",
          "nameUr": "اصل دستاویز",
          "description": "Original document requiring Apostille attestation",
          "isMandatory": true
        },
        {
          "id": "DOC_M002",
          "name": "CNIC/Passport",
          "nameUr": "شناخت کارڈ / پاسپورٹ",
          "description": "Applicant's ID Card or Passport",
          "isMandatory": true
        },
        {
          "id": "DOC_M003",
          "name": "Authorization Letter",
          "nameUr": "اختیار نامہ",
          "description": "Signed authorization letter (if representative applies)",
          "isMandatory": false
        }
      ],
      "paymentInfo": {
        "baseFee": 3000,
        "currency": "PKR",
        "variations": [
          {
            "type": "Personal Document",
            "amount": 3000
          },
          {
            "type": "Educational Document",
            "amount": 3000
          },
          {
            "type": "Legal Document",
            "amount": 4500
          },
          {
            "type": "Commercial Document",
            "amount": 12000
          },
          {
            "type": "Experience Certificate",
            "amount": 3000
          }
        ]
      },
      "applicationStages": [
        {
          "stageNumber": 1,
          "name": "Online Application",
          "nameUr": "آن لائن درخواست",
          "description": "Application through Apostille Portal and submission of original documents",
          "duration": "15 minutes"
        },
        {
          "stageNumber": 2,
          "name": "Verification",
          "nameUr": "تصدیق",
          "description": "Verification and confirmation of document authenticity and prior attestations",
          "duration": "2-3 hours"
        },
        {
          "stageNumber": 3,
          "name": "Issuance & Collection",
          "nameUr": "جاری اور حاصل کرنا",
          "description": "Apostille certificate is affixed and document returned to applicant",
          "duration": "Same day"
        }
      ],
      "processingTime": {
        "value": 3,
        "unit": "hours",
        "type": "same_day"
      },
      "keyHighlights": {
        "estimatedWaitTime": "3-4 hours",
        "successRate": "98%",
        "requiresAppointment": false,
        "onlineApplicationRequired": true
      },
      "contactInfo": {
        "helpline": "+92-51-XXXXXX",
        "office": "Ministry of Foreign Affairs, Islamabad",
        "website": "www.mofa.gov.pk"
      },
      "eligibilityRequirements": {
        "minAge": 0,
        "maxAge": null,
        "citizenship": "Pakistani and Foreign nationals",
        "residencyRequired": false
      },
      "importantNotes": [
        "Apostille is affixed only to original documents; photocopies not accepted",
        "Online application mandatory (except legal documents - physical visit only)",
        "Apostille remains valid indefinitely unless document expires",
